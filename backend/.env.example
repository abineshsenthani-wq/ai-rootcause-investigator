# Environment Configuration for AI Root-Cause Investigator

PROJECT_NAME="AI Root-Cause Investigator"
ENV="development"
LOG_LEVEL="INFO"

# Server Settings
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage & Database
DATABASE_URL="sqlite:///./investigator.db"
DATA_STORAGE_DIR="./data/uploads"

# LLM Configuration (Optional - standard deterministic template engine fallback used if unconfigured)
LLM_PROVIDER="openai" # options: "openai", "anthropic", "fallback"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_MODEL="gpt-4o-mini"
